---
interface Props {
  id: string;
  title: string;
  accent: string;
  lead?: string;
  /** Posición del encabezado en escritorio; en celular "right" pasa a la izquierda */
  align?: "center" | "left" | "right";
}

const { id, title, accent, lead, align = "center" } = Astro.props;
---

<div class:list={["section-heading", {
    "section-heading--left": align === "left",
    "section-heading--right": align === "right",
  }]}>
  <h2 id={id}>{title} <span>{accent}</span></h2>
  {lead && <p class="section-heading__lead">{lead}</p>}
</div>
