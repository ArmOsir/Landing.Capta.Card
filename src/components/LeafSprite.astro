---
/**
 * Hoja de Capta Card dibujada en SVG, inspirada en la hoja de línea fina de la
 * tarjeta: punta inclinada, mitad sombreada, nervadura central y una segunda
 * vena. Se define una sola vez y se reutiliza con <use href="#capta-leaf">.
 * Los colores salen de variables CSS (--leaf-*) y cambian con el tema.
 */
---

<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <defs>
    <linearGradient id="capta-leaf-grad" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" style="stop-color:var(--leaf-solid-a)"></stop>
      <stop offset="1" style="stop-color:var(--leaf-solid-b)"></stop>
    </linearGradient>
  </defs>

  <symbol id="capta-leaf" viewBox="0 0 120 200">
    <path d="M78 4C30 44 10 100 34 152C44 174 56 190 60 198C62 150 70 80 78 4Z" style="fill:var(--leaf-fill)"></path>
    <path
      d="M78 4C30 44 10 100 34 152C44 174 56 190 60 198C66 160 96 130 104 90C110 56 98 26 78 4Z"
      style="fill:none;stroke:var(--leaf-stroke)"
      stroke-width="1.3"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"></path>
    <path
      d="M60 198C62 150 70 80 78 4"
      style="fill:none;stroke:var(--leaf-stroke)"
      stroke-width="1.3"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"></path>
    <path
      d="M60 198C58 158 78 122 96 72"
      style="fill:none;stroke:var(--leaf-stroke);opacity:.55"
      stroke-width="1"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"></path>
  </symbol>

  <symbol id="capta-leaf-solid" viewBox="0 0 120 200">
    <path
      d="M78 4C30 44 10 100 34 152C44 174 56 190 60 198C66 160 96 130 104 90C110 56 98 26 78 4Z"
      fill="url(#capta-leaf-grad)"></path>
    <path
      d="M60 198C62 150 70 80 78 4"
      style="fill:none;stroke:var(--leaf-solid-vein)"
      stroke-width="1.4"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"></path>
  </symbol>
</svg>
