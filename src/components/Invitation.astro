---
import SectionBackdrop from "./SectionBackdrop.astro";
import { appLinks, contact, rollout } from "../data/site";

const hasStores = Boolean(appLinks.appStore || appLinks.googlePlay);
---

<section class="section section--band" id="descarga" aria-labelledby="download-title">
  <SectionBackdrop variant="corners" />
  <div class="section__inner">
    <div class="invite invite--flip">
      <div class="invite__copy">
        <h2 id="download-title">¿Ya recibiste <span>tu invitación?</span></h2>
        <p>
          Capta Card llega solo por invitación. Si recibiste el SMS, descarga la app de Capta Card y empieza tu
          registro desde tu celular.
        </p>

        {
          hasStores ? (
            <div class="invite__actions">
              {appLinks.appStore && (
                <a class="btn btn--primary" href={appLinks.appStore} rel="noopener">
                  Descargar para iPhone
                </a>
              )}
              {appLinks.googlePlay && (
                <a class="btn btn--ghost" href={appLinks.googlePlay} rel="noopener">
                  Descargar para Android
                </a>
              )}
            </div>
          ) : (
            <div class="invite__path">
              <h3>Abre el enlace de tu SMS</h3>
              <p>Ahí encontrarás la descarga de la app para iPhone o Android.</p>
            </div>
          )
        }

        <div class="rollout">
          <h3>¿Aún no recibes tu SMS?</h3>
          <p>Llegamos por etapas: primero la familia Capta, luego todos.</p>
          <ol>
            {
              rollout.map((stage) => (
                <li>
                  <div>
                    {stage.group}
                    {stage.detail && <span>{stage.detail}</span>}
                  </div>
                  {stage.when === "Próximamente" ? <em>{stage.when}</em> : <time>{stage.when}</time>}
                </li>
              ))
            }
          </ol>
        </div>

        <p class="invite__hint">
          ¿Tienes dudas? Escríbenos a <a href={`mailto:${contact.supportEmail}`}>{contact.supportEmail}</a>.
        </p>
      </div>
      <div class="invite__visual" aria-hidden="true">
        <div class="sparks">
          <span class="spark" style="--x:8%; --y:30%; --s:5px; --delay:-1s"></span>
          <span class="spark" style="--x:46%; --y:8%; --s:4px; --delay:-2.4s"></span>
          <span class="spark" style="--x:88%; --y:74%; --s:6px; --delay:-0.3s"></span>
          <span class="spark" style="--x:58%; --y:96%; --s:4px; --delay:-3.1s"></span>
          <span class="spark spark--far" style="--x:20%; --y:94%; --s:3px; --delay:-1.8s"></span>
        </div>
        <img class="invite__card invite__card--back" src="/images/TC%20Capta%20Card%20trasera.svg" alt="" loading="lazy" width="482" height="300" />
        <img class="invite__card invite__card--front" src="/images/TC%20Capta%20Card%20frente.svg" alt="" loading="lazy" width="482" height="300" />
      </div>
    </div>
  </div>
</section>
