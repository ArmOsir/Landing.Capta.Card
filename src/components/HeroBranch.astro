---
/**
 * Rama decorativa de la esquina superior derecha del Hero.
 * Cae desde la esquina hacia abajo a la izquierda, con hojas sólidas y de
 * contorno (las mismas de LeafSprite) que se mecen, se apartan del puntero y,
 * de vez en cuando, se desprenden. Es solo decoración: no recibe clics.
 * Con prefers-reduced-motion la rama queda quieta.
 */
---

<div class="hero-branch" aria-hidden="true">
  <svg class="hero-branch__svg" viewBox="368 -10 322 350" focusable="false" data-branch>
    <g class="hero-branch__sparks">
      <circle cx="560" cy="70" r="3" style="--d:-0.4s"></circle>
      <circle cx="622" cy="160" r="3.5" style="--d:-1.9s"></circle>
      <circle cx="455" cy="262" r="2.5" style="--d:-3.1s"></circle>
      <circle cx="596" cy="252" r="2" style="--d:-1.2s"></circle>
    </g>
    <g data-branch-body>
      <path
        data-branch-stem
        d="M690 -6 C645 28 598 50 556 92 C514 134 496 182 470 228 C446 270 416 302 380 330"
        class="hero-branch__stem"></path>
      <path data-branch-twig="1" d="M598 52 C590 80 594 104 604 128" class="hero-branch__twig"></path>
      <path data-branch-twig="2" d="M500 160 C470 170 452 188 440 210" class="hero-branch__twig"></path>
      <g data-branch-leaves></g>
    </g>
    <g data-branch-falling></g>
  </svg>
</div>

<script>
  const NS = "http://www.w3.org/2000/svg";
  const svg = document.querySelector<SVGSVGElement>("[data-branch]");
  const stem = document.querySelector<SVGPathElement>("[data-branch-stem]");
  const body = document.querySelector<SVGGElement>("[data-branch-body]");
  const leavesGroup = document.querySelector<SVGGElement>("[data-branch-leaves]");
  const fallingGroup = document.querySelector<SVGGElement>("[data-branch-falling]");

  if (svg && stem && body && leavesGroup && fallingGroup) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    type Leaf = { g: SVGGElement; x: number; y: number; base: number; k: number; a: number; v: number; phase: number; freq: number };
    const leaves: Leaf[] = [];

    const addLeaf = (x: number, y: number, base: number, k: number, solid: boolean) => {
      const g = document.createElementNS(NS, "g");
      const use = document.createElementNS(NS, "use");
      use.setAttribute("href", solid ? "#capta-leaf-solid" : "#capta-leaf");
      use.setAttribute("width", "120");
      use.setAttribute("height", "200");
      use.setAttribute("x", "-60");
      use.setAttribute("y", "-198");
      g.appendChild(use);
      leavesGroup.appendChild(g);
      leaves.push({ g, x, y, base, k, a: 0, v: 0, phase: Math.random() * Math.PI * 2, freq: 0.6 + Math.random() * 0.5 });
    };

    // Hojas a lo largo del tallo: alternan lado, se achican hacia la punta y
    // cuelgan un poco por la gravedad.
    const plan: [number, number, number, boolean][] = [
      [0.1, 1, 0.3, true], [0.16, -1, 0.36, false], [0.24, 1, 0.42, false], [0.31, -1, 0.3, true],
      [0.39, 1, 0.38, false], [0.46, -1, 0.4, false], [0.54, 1, 0.28, true], [0.61, -1, 0.34, false],
      [0.69, 1, 0.3, false], [0.76, -1, 0.22, true], [0.84, 1, 0.26, false], [0.92, -1, 0.18, true],
      [1, 0, 0.2, false],
    ];
    const length = stem.getTotalLength();
    for (const [t, side, k, solid] of plan) {
      const s = length * t;
      const p = stem.getPointAtLength(s);
      const prev = stem.getPointAtLength(Math.max(0, s - 2));
      const tangent = (Math.atan2(p.y - prev.y, p.x - prev.x) * 180) / Math.PI;
      const rot = (tangent + 90 + side * 62 + (side === 0 ? -90 : 0)) * 0.75 + 45;
      addLeaf(p.x, p.y, rot, k, solid);
    }
    const twigLeaf = (id: string, t: number, rot: number, k: number, solid: boolean) => {
      const path = document.querySelector<SVGPathElement>(`[data-branch-twig="${id}"]`);
      if (!path) return;
      const p = path.getPointAtLength(path.getTotalLength() * t);
      addLeaf(p.x, p.y, rot + 180, k, solid);
    };
    twigLeaf("1", 1, -170, 0.3, true);
    twigLeaf("2", 1, -120, 0.26, false);
    twigLeaf("1", 0.55, -120, 0.22, false);

    // ── Tamaño: la rama crece solo hasta donde no toca el titular ni la insignia ──
    const host = svg.parentElement as HTMLElement;
    const fit = () => {
      host.style.width = "";
      const maxW = host.getBoundingClientRect().width;
      const top = host.getBoundingClientRect().top + window.scrollY;
      const lines: DOMRect[] = [];
      for (const selector of [".landing-intro h1", ".landing-intro__badge", ".landing-intro__description"]) {
        const el = document.querySelector(selector);
        if (!el) continue;
        const range = document.createRange();
        range.selectNodeContents(el);
        lines.push(...Array.from(range.getClientRects()));
      }
      // Extensión real de la rama con sus hojas (pueden salir de la caja del SVG)
      const bb = body.getBBox();
      const gap = 16;
      for (let w = Math.round(maxW); w >= 48; w -= 4) {
        const unit = w / 322;
        const bottom = top + (bb.y + bb.height + 10 + 10) * unit;
        const left = window.innerWidth - w + (bb.x - 368) * unit;
        const hits = lines.some((r) => r.top + window.scrollY < bottom && r.right + gap > left);
        if (!hits) {
          host.style.width = `${w}px`;
          host.style.removeProperty("display");
          return;
        }
      }
      host.style.display = "none";
    };
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(fit, 120);
    });
    document.fonts?.ready.then(fit);

    const place = (l: Leaf) =>
      l.g.setAttribute("transform", `translate(${l.x} ${l.y}) rotate(${(l.base + l.a).toFixed(2)}) scale(${l.k})`);
    leaves.forEach(place);
    fit();

    if (!reduceMotion) {
      // ── Puntero en coordenadas del SVG ──
      let px = -9999;
      let py = -9999;
      let speed = 0;
      let lastX = 0;
      let lastY = 0;
      const pt = svg.createSVGPoint();

      const onPointerMove = (event: PointerEvent) => {
        const ctm = svg.getScreenCTM();
        if (!ctm) return;
        pt.x = event.clientX;
        pt.y = event.clientY;
        const local = pt.matrixTransform(ctm.inverse());
        speed = Math.min(40, Math.hypot(local.x - lastX, local.y - lastY));
        lastX = px = local.x;
        lastY = py = local.y;
      };

      // ── Hojas que se desprenden ──
      type Faller = { g: SVGGElement; x: number; y: number; vy: number; phase: number; k: number; life: number };
      const fallers: Faller[] = [];
      let nextFall = 3;
      const spawnFall = () => {
        const src = leaves[3 + Math.floor(Math.random() * (leaves.length - 4))];
        const g = document.createElementNS(NS, "g");
        const use = document.createElementNS(NS, "use");
        use.setAttribute("href", Math.random() < 0.5 ? "#capta-leaf-solid" : "#capta-leaf");
        use.setAttribute("width", "120");
        use.setAttribute("height", "200");
        use.setAttribute("x", "-60");
        use.setAttribute("y", "-100");
        g.appendChild(use);
        fallingGroup.appendChild(g);
        fallers.push({ g, x: src.x, y: src.y, vy: 0.35 + Math.random() * 0.25, phase: Math.random() * 6, k: 0.14 + Math.random() * 0.06, life: 0 });
      };

      let frame = 0;
      let last = performance.now();
      const bottom = 330;

      const tick = (now: number) => {
        frame = 0;
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        const t = now / 1000;

        body.setAttribute("transform", `rotate(${(Math.sin(t * 0.5) * 0.6).toFixed(3)} 690 -6)`);

        for (const l of leaves) {
          const rad = ((l.base + l.a) * Math.PI) / 180;
          const ux = Math.sin(rad);
          const uy = -Math.cos(rad);
          const cx = l.x + ux * 95 * l.k;
          const cy = l.y + uy * 95 * l.k;
          let target = Math.sin(t * l.freq + l.phase) * 4;
          const d = Math.hypot(px - cx, py - cy);
          const R = 90;
          if (d < R) {
            // Se aparta hacia el lado contrario del puntero, más si pasa rápido
            const cross = ux * (py - l.y) - uy * (px - l.x);
            const near = 1 - d / R;
            target -= Math.sign(cross) * near * 38;
            l.v -= Math.sign(cross) * speed * 0.08 * near;
          }
          l.v += (target - l.a) * 0.06;
          l.v *= 0.86;
          l.a += l.v;
          place(l);
        }
        speed *= 0.8;

        nextFall -= dt;
        if (nextFall <= 0) {
          spawnFall();
          nextFall = 4 + Math.random() * 3;
        }
        for (let i = fallers.length - 1; i >= 0; i--) {
          const f = fallers[i];
          f.life += dt;
          f.y += f.vy * 60 * dt;
          f.x += Math.sin(f.life * 1.6 + f.phase) * 0.8 - 0.25;
          const rot = Math.sin(f.life * 1.4 + f.phase) * 50 + 20;
          const opacity = Math.max(0, Math.min(1, f.life * 2)) * Math.max(0, 1 - (f.y - 200) / (bottom - 200));
          f.g.setAttribute("transform", `translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${rot.toFixed(1)}) scale(${f.k})`);
          f.g.setAttribute("opacity", opacity.toFixed(3));
          if (f.y > bottom || (opacity <= 0 && f.life > 1)) {
            f.g.remove();
            fallers.splice(i, 1);
          }
        }

        frame = requestAnimationFrame(tick);
      };

      // Solo se anima mientras el Hero está en pantalla y la pestaña visible
      let visible = false;
      const sync = () => {
        const run = visible && !document.hidden;
        if (run && !frame) {
          last = performance.now();
          frame = requestAnimationFrame(tick);
          window.addEventListener("pointermove", onPointerMove, { passive: true });
        } else if (!run && frame) {
          cancelAnimationFrame(frame);
          frame = 0;
          window.removeEventListener("pointermove", onPointerMove);
        }
      };
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      }).observe(svg);
      document.addEventListener("visibilitychange", sync);
    }
  }
</script>

<style>
  .hero-branch {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    /* Ocupa solo el hueco a la derecha del contenido (que mide hasta 980px) */
    width: clamp(170px, calc((100vw - 980px) / 2 + 30px), 360px);
    aspect-ratio: 322 / 350;
    pointer-events: none;
    --leaf-stroke: rgb(74 222 128 / 55%);
    --leaf-fill: rgb(34 197 94 / 12%);
  }

  .hero-branch__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hero-branch__stem,
  .hero-branch__twig {
    fill: none;
    stroke: rgb(74 222 128 / 45%);
    stroke-linecap: round;
    stroke-width: 2;
  }

  .hero-branch__twig {
    stroke: rgb(74 222 128 / 35%);
    stroke-width: 1.4;
  }

  .hero-branch__sparks circle {
    fill: #d9f99d;
    filter: drop-shadow(0 0 4px rgb(163 230 53 / 70%));
    animation: branch-spark 4.2s ease-in-out var(--d, 0s) infinite;
  }

  :global(.landing-shell[data-theme="light"]) .hero-branch {
    --leaf-stroke: rgb(29 111 63 / 55%);
    --leaf-fill: rgb(33 139 67 / 12%);
  }

  :global(.landing-shell[data-theme="light"]) .hero-branch__stem,
  :global(.landing-shell[data-theme="light"]) .hero-branch__twig {
    stroke: rgb(29 111 63 / 45%);
  }

  :global(.landing-shell[data-theme="light"]) .hero-branch__sparks circle {
    fill: #65a30d;
    filter: drop-shadow(0 0 4px rgb(101 163 13 / 50%));
  }

  @keyframes branch-spark {
    0%,
    100% {
      opacity: 0.35;
    }

    50% {
      opacity: 1;
    }
  }

  /* Pantallas medianas y móviles: versión pequeña, debajo del encabezado */
  @media (max-width: 1100px) {
    .hero-branch {
      top: 56px;
      width: 150px;
      opacity: 0.75;
    }
  }

  @media (max-width: 620px) {
    .hero-branch {
      top: 60px;
      width: 72px;
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-branch__sparks circle {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
