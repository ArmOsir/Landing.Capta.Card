---
interface Props {
  footer?: boolean;
}

const { footer = false } = Astro.props;
---

<a class:list={["brand", { "brand--footer": footer }]} href="#inicio" aria-label="Capta Card, inicio">
  <img class="brand__logo brand__logo--on-dark" src="/images/logo-capta-claro.png" alt="" width="473" height="200" />
  <img class="brand__logo brand__logo--on-light" src="/images/logo-capta.png" alt="" width="473" height="200" />
</a>
