---
import Brand from "./Brand.astro";
import { condusef, contact, legal, legalHref, legalPages, supportHref } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div>
        <Brand footer />
        <p>Crédito que crece en comunidad.</p>
      </div>
      <nav class="site-footer__links" aria-label="Pie de página">
        <a href="/#beneficios">La tarjeta</a>
        <a href="/#como-funciona">Cómo funciona</a>
        <a href="/#pagos">Pagos</a>
        <a href="/#ayuda">Preguntas</a>
      </nav>
    </div>

    <div class="site-footer__contact">
      <h2>Atención a clientes</h2>
      <ul>
        {contact.phone && (
          <li>
            Teléfono: <a href={`tel:${contact.phone.replace(/\s+/g, "")}`}>{contact.phone}</a>
          </li>
        )}
        {contact.whatsapp && (
          <li>
            <a href={supportHref} rel="noopener">Escríbenos por WhatsApp</a>
          </li>
        )}
        <li>
          Correo: <a href={`mailto:${contact.supportEmail}`}>{contact.supportEmail}</a>
        </li>
        <li>
          <a href={legalHref("une-y-aclaraciones")}>Unidad Especializada de Atención (UNE) y aclaraciones</a>
        </li>
        <li>
          <a href={condusef.url} rel="noopener">{condusef.name}</a>: Comisión Nacional para la Protección y Defensa de
          los Usuarios de Servicios Financieros.
        </li>
      </ul>
    </div>

    <div class="site-footer__legal">
      <div>
        {
          legal.cat && (
            <p>
              CAT promedio {legal.cat}% sin IVA. Para fines informativos y de comparación
              {legal.catDate && `, calculado al ${legal.catDate}`}.
            </p>
          )
        }
        <p>
          {legal.interestRate && <>*Tasa de interés anual fija de {legal.interestRate}%. </>}
          Producto sujeto a aprobación de crédito. Consulta requisitos, <a href={legalHref("comisiones-y-cat")}>comisiones y CAT</a>. Las condiciones
          vigentes del producto prevalecen.
          {legal.issuer && <> Tarjeta emitida por {legal.issuer} bajo la licencia de Mastercard Internacional.</>}
        </p>
        <nav class="site-footer__docs" aria-label="Documentos legales">
          {legalPages.map((p) => <a href={legalHref(p.slug)}>{p.title}</a>)}
        </nav>
      </div>
      <p class="site-footer__copyright">© {year} Capta Card</p>
    </div>
  </div>
</footer>
