---
import SectionBackdrop from "../SectionBackdrop.astro";
---

<section class="section section--band" id="anualidad" aria-labelledby="p3-annual-title">
  <SectionBackdrop variant="corners" leaves={false} />
  <div class="section__inner p3-annual">
    <p class="p3-annual__num" aria-hidden="true">$0</p>
    <div>
      <div class="section-heading section-heading--left">
        <h2 id="p3-annual-title">Sin <span>anualidad.</span></h2>
      </div>
      <p class="p3-lead">
        Tu Capta Card no tiene costo anual y su apertura es de $0. Úsala con tranquilidad desde el primer día.
      </p>
      <ul class="p3-checks">
        <li>$0 de anualidad</li>
        <li>$0 de apertura</li>
      </ul>
      <a class="btn btn--primary" href="#descarga">Solicitar mi Capta Card</a>
      <p class="p3-fine">Sujeto a aprobación. Consulta comisiones y CAT en la app.</p>
    </div>
  </div>
</section>
