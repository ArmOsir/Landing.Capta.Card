---
import SectionHeading from "../SectionHeading.astro";
import SectionBackdrop from "../SectionBackdrop.astro";

const items = [
  {
    href: "#anualidad",
    title: "Sin anualidad",
    text: "No pagas por tener tu tarjeta. Y la apertura también es de $0.",
    paths: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z", "M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8", "M12 18V6"],
  },
  {
    href: "#mastercard",
    title: "Parte de Mastercard",
    text: "Úsala en comercios y en línea, en México y en el extranjero.",
    paths: ["M2 5h20v14H2z", "M2 10h20", "M6 15h4"],
  },
  {
    href: "#wallet",
    title: "Paga con un toque",
    text: "Agrégala a la wallet de tu celular y paga sin sacar tu tarjeta.",
    paths: ["M6 8.3a7.4 7.4 0 0 1 0 7.4", "M9.5 6.2a11.8 11.8 0 0 1 0 11.6", "M12.9 4.1a15.9 15.9 0 0 1 0 15.8", "M16.4 2a20.2 20.2 0 0 1 0 20"],
  },
  {
    href: "#seguridad",
    title: "Segura",
    text: "Bloquéala desde la app en segundos y controla cada movimiento.",
    paths: [
      "M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.7 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.5 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z",
      "M9 12l2 2 4-4",
    ],
  },
];
---

<section class="section" id="beneficios" aria-labelledby="p3-benefits-title">
  <SectionBackdrop variant="benefits" leaves={false} />
  <div class="section__inner">
    <SectionHeading
      id="p3-benefits-title"
      title="Una tarjeta pensada para"
      accent="crecer contigo."
      lead="Sin anualidad, con el respaldo de Mastercard, lista para pagar con un toque desde tu celular y protegida en todo momento."
    />

    <div class="benefits__grid">
      {
        items.map((item, i) => (
          <a class:list={["card", "benefit", "p3-link-card", { "card--accent": i === 0 }]} href={item.href}>
            <div class="benefit__top">
              <span class="chip">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                  {item.paths.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
              <span class="p3-arrow" aria-hidden="true">→</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
