---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Capta Card — crédito que crece contigo",
  description = "Conoce Capta Card, la tarjeta de crédito Mastercard de la comunidad Capta. Recibe una invitación, solicita desde la app y controla tu tarjeta desde tu celular.",
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1f0f" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        var saved = localStorage.getItem("capta-theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
