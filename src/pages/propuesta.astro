    .sec-card__rows {
      display: grid;
      margin-top: auto;
      padding-top: 40px;
      gap: 12px;
    }

    .sec-card__rows div {
      display: flex;
      padding: 18px 22px;
      justify-content: space-between;
      align-items: center;
      border-radius: 18px;
      background: rgb(255 255 255 / 9%);
