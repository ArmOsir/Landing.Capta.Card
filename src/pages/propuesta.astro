    .sec-card__icons {
      display: flex;
      justify-content: center;
      gap: 14px;
    }

    .sec-card__icons span {
      display: grid;
      width: 48px;
      height: 48px;
      place-items: center;
      border-radius: 50%;
      background: rgb(255 255 255 / 14%);
