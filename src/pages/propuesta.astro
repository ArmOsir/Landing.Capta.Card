    /* Pila de tarjetas: frente y reverso caen sobre una base verde y flotan */
    .stack {
      position: relative;
      width: 100%;
      height: 400px;
      max-width: 560px;
      margin: 0 auto;
      perspective: 1200px;
    }

    .stack__shelf {
      position: absolute;
      right: 4%;
      bottom: 0;
      left: 4%;
      height: 46%;
      border-radius: 28px;
      background: linear-gradient(180deg, #123f29 0%, #0b1f0f 100%);
      box-shadow: 0 30px 50px -30px rgb(11 31 15 / 60%);
    }

    .stack__back,
    .stack__front {
      position: absolute;
      width: 74%;
      height: auto;
      border-radius: 18px;
      box-shadow: 0 30px 50px -20px rgb(11 31 15 / 55%);
    }

    .stack__back {
      top: 8%;
      right: 2%;
      transform: rotate(10deg);
      animation: stack-drop-back 1.3s cubic-bezier(0.22, 0.8, 0.3, 1) both, stack-float-back 6s ease-in-out 1.3s infinite;
    }

    .stack__front {
      bottom: 10%;
      left: 4%;
      transform: rotate(-8deg);
      animation: stack-drop 1.3s cubic-bezier(0.22, 0.8, 0.3, 1) 0.15s both, stack-float 5s ease-in-out 1.45s infinite;
    }

    .stack__front .tilt {
      width: 100%;
    }

    .stack__front .tilt img {
      animation: none;
    }

    @keyframes stack-drop {
      0% {
        transform: translate(-30px, -460px) rotate(-30deg);
        opacity: 0;
      }

      12% {
        opacity: 1;
      }

      58% {
        transform: translate(0, -6px) rotate(-6deg);
      }

      72% {
        transform: translate(0, -40px) rotate(-10deg);
      }

      100% {
        transform: rotate(-8deg);
        opacity: 1;
      }
    }

    @keyframes stack-float {
      0%,
      100% {
        transform: rotate(-8deg) translateY(0);
      }

      50% {
        transform: rotate(-5deg) translateY(-12px);
      }
    }

    @keyframes stack-drop-back {
      0% {
        transform: translate(60px, -460px) rotate(34deg);
        opacity: 0;
      }

      12% {
        opacity: 1;
      }

      60% {
        transform: translate(0, 40px) rotate(8deg);
      }

      100% {
        transform: rotate(10deg);
        opacity: 1;
      }
    }

    @keyframes stack-float-back {
      0%,
      100% {
        transform: rotate(10deg) translateY(0);
      }

      50% {
        transform: rotate(12deg) translateY(-8px);
      }
    }

    @media (max-width: 620px) {
      .stack {
        height: 300px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .stack__back,
      .stack__front {
        animation: none;
      }
    }

    /* ── Color y vida: degradados, hojas y acentos Capta ── */
