    }

    .sec-card--green {
      background: linear-gradient(180deg, #5a9a3c 0%, #2b4a25 70%, #1d3219 100%);
    }

    .sec-card--dark {
      background: linear-gradient(180deg, #14351f 0%, #0b1f0f 100%);
    }

    .sec-card--ink {
      background: linear-gradient(180deg, #0b1f0f 0%, #07140b 100%);
    }

    .sec-card__visual {
      display: grid;
      flex: 1;
      place-items: center;
      padding: 28px 0;
    }

    .sec-card__visual img {
      display: block;
      width: 78%;
      height: auto;
      border-radius: 14px;
      box-shadow: 0 20px 30px -16px rgb(0 0 0 / 60%);
