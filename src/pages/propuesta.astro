---
/**
 * Propuesta de landing (versión de desarrollo, no publicada).
 * Sigue el diseño y el texto de "Capta Card — Propuesta de landing.html" y
 * agrega interacciones. Vive en /propuesta, con noindex, mientras se decide si
 * reemplaza a la página principal. Pendientes que se corrigen sobre la marcha:
 * tasa (65% en la propuesta), exención de anualidad registrada en la carátula
 * y recálculo del CAT.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import LeafSprite from "../components/LeafSprite.astro";
import "../styles/global.css";

const benefits = [
  { href: "#anualidad", title: "Sin anualidad", text: "No pagas por tener tu tarjeta. Y la apertura también es de $0.", paths: ["M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8", "M12 18V6"], ring: true },
  { href: "#mastercard", title: "Parte de Mastercard", text: "Úsala en comercios y en línea, en México y en el extranjero.", paths: ["M2 5h20v14H2z", "M2 10h20", "M6 15h4"] },
  { href: "#wallet", title: "Paga con un toque", text: "Agrégala a la wallet de tu celular y paga sin sacar tu tarjeta.", paths: ["M6 8.3a7.4 7.4 0 0 1 0 7.4", "M9.5 6.2a11.8 11.8 0 0 1 0 11.6", "M12.9 4.1a15.9 15.9 0 0 1 0 15.8", "M16.4 2a20.2 20.2 0 0 1 0 20"] },
  { href: "#seguridad", title: "Segura", text: "Bloquéala desde la app en segundos y controla cada movimiento.", paths: ["M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.7 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.5 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z", "M9 12l2 2 4-4"] },
];

const mastercardUses = [
  { title: "En comercios", text: "Paga con tu tarjeta o con un toque desde tu celular.", paths: ["M3 9l1.5-5h15L21 9", "M4 9v11h16V9", "M9 20v-6h6v6"] },
  { title: "En línea", text: "Compra en tus tiendas y apps favoritas.", paths: ["M3 4h18v13H3z", "M8 21h8M12 17v4"] },
  { title: "En el extranjero", text: "Viaja con tu Capta Card a donde aceptan Mastercard.", paths: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z", "M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"] },
];

const steps = [
  { n: "01", title: "Recibe tu invitación", text: "Te llega por SMS a tu celular." },
  { n: "02", title: "Regístrate en la app", text: "Crea tu cuenta y verifica tu identidad." },
  { n: "03", title: "Conoce tu resultado", text: "Te avisamos en la app si fuiste aprobado." },
  { n: "04", title: "Recibe tu tarjeta", text: "Se entrega con validación de identidad." },
  { n: "05", title: "Actívala con tu NIP", text: "Y empieza a usarla." },
];

const faqs = [
  { q: "¿Cómo obtengo mi Capta Card?", a: "Por ahora es solo por invitación. Si recibiste tu SMS, descarga la app, regístrate y verifica tu identidad." },
  { q: "¿Cuánto cuesta?", a: "La tasa de interés es fija de 65% anual y la tarjeta no tiene anualidad. Consulta comisiones y CAT en la app." },
  { q: "¿Por qué mi tarjeta no trae mi nombre?", a: "Es una tarjeta innominada: no lleva nombre impreso y queda vinculada a ti en cuanto la activas en la app." },
  { q: "¿Qué hago si veo un cargo que no reconozco?", a: "Bloquea tu tarjeta desde la app y presenta tu aclaración. Te entregaremos un folio para darle seguimiento." },
  { q: "¿Puedo pagar más de lo que debo?", a: "No. El pago máximo es tu saldo total." },
];
---

<BaseLayout
  title="Propuesta de landing — Capta Card"
  description="Propuesta de rediseño de la landing de Capta Card (versión de desarrollo)."
  noindex
>
  <div class="prop">
    <LeafSprite />
    <header class="prop-nav">
      <div class="prop-wrap prop-nav__in">
        <a href="#inicio" aria-label="Capta Card, inicio"><img src="/images/logo-capta.png" alt="Capta Card" width="473" height="200" /></a>
        <nav aria-label="Principal">
          <a href="#beneficios">Beneficios</a>
          <a href="#wallet">Wallet</a>
          <a href="#mastercard">Mastercard</a>
          <a href="#como-funciona">Cómo funciona</a>
          <a href="#seguridad">Seguridad</a>
          <a href="#ayuda">Ayuda</a>
        </nav>
        <a class="btn btn--dark" href="#descarga">Ya tengo mi invitación</a>
      </div>
    </header>

    <!-- HERO -->
    <section id="inicio" class="hero">
      <div class="prop-wrap hero__in">
        <div class="hero__copy reveal">
          <h1>Tus Planes. Tu Control. <span>Tu Capta Card.</span></h1>
          <p>Sin anualidad, con el respaldo de Mastercard y lista para pagar con un toque desde tu celular. Tú decides cómo usarla.</p>
          <div class="hero__actions">
            <a class="btn btn--dark" href="#descarga">Ya tengo mi invitación</a>
            <a class="btn btn--outline" href="#como-funciona">Cómo funciona</a>
          </div>
          <ul class="chips" aria-label="Lo que incluye">
            <li><span class="chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8" /><path d="M12 18V6" /></svg></span>Sin anualidad</li>
            <li><span class="chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /><path d="M6 15h4" /></svg></span>Red Mastercard</li>
            <li><span class="chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8.3a7.4 7.4 0 0 1 0 7.4" /><path d="M9.5 6.2a11.8 11.8 0 0 1 0 11.6" /><path d="M12.9 4.1a15.9 15.9 0 0 1 0 15.8" /><path d="M16.4 2a20.2 20.2 0 0 1 0 20" /></svg></span>Paga con un toque</li>
            <li><span class="chip-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.7 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.5 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z" /><path d="M9 12l2 2 4-4" /></svg></span>Segura</li>
          </ul>
          <p class="legal-line">Tasa de interés anual fija de 65%. Sin anualidad. Sujeto a aprobación. Consulta requisitos, comisiones y CAT en la app.</p>
        </div>
        <div class="hero__visual reveal" data-tilt-stage>
          <div class="stack">
            <div class="stack__shelf" aria-hidden="true"></div>
            <img class="stack__back" src="/images/TC%20Capta%20Card%20trasera.svg" alt="" width="482" height="300" />
            <div class="stack__front">
              <div class="tilt" data-tilt>
                <img src="/images/TC%20Capta%20Card%20frente.svg" alt="Tarjeta Capta Card, frente" width="482" height="300" />
              </div>
            </div>
          </div>
          <p class="hint">Mueve el cursor sobre la tarjeta.</p>
        </div>
      </div>
    </section>

    <!-- BENEFICIOS -->
    <section id="beneficios" class="sec">
      <div class="prop-wrap">
        <div class="sec__head reveal">
          <h2>Una tarjeta pensada para crecer contigo.</h2>
          <p>Sin anualidad, con el respaldo de Mastercard, lista para pagar con un toque desde tu celular y protegida en todo momento.</p>
        </div>
        <div class="grid4">
          {benefits.map((b) => (
            <a class="benefit reveal" href={b.href}>
              <span class:list={["benefit__icon", { "benefit__icon--ring": b.ring }]} aria-hidden="true">
                <svg viewBox="0 0 24 24">{b.paths.map((d) => <path d={d} />)}</svg>
              </span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ANUALIDAD -->
    <section id="anualidad" class="sec sec--stone">
      <div class="prop-wrap split">
        <div class="reveal">
          <p class="big-zero" aria-hidden="true">$0</p>
        </div>
        <div class="reveal">
          <h2>Sin anualidad.</h2>
          <p>Tu Capta Card no tiene costo anual y su apertura es de $0. Úsala con tranquilidad desde el primer día.</p>
          <div class="pills">
            <span><svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7" /></svg>$0 de anualidad</span>
            <span><svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7" /></svg>$0 de apertura</span>
          </div>
          <a class="btn btn--dark" href="#descarga">Solicitar mi Capta Card</a>
          <p class="fine">Sujeto a aprobación. Consulta comisiones y CAT en la app.</p>
        </div>
      </div>
    </section>

    <!-- WALLET -->
    <section id="wallet" class="sec sec--ink">
      <div class="prop-wrap split">
        <div class="reveal">
          <span class="eyebrow">Wallet</span>
          <h2>Paga con un solo toque.</h2>
          <p>Agrega tu Capta Card a la wallet de tu celular y paga acercándolo a la terminal. Sin sacar tu tarjeta, sin insertarla y sin firmar.</p>
          <ol class="wallet-steps">
            <li><span>1</span>Agrega tu tarjeta a la wallet de tu celular</li>
            <li><span>2</span>Acerca tu celular a la terminal</li>
            <li><span>3</span>Listo, tu compra aparece en la app</li>
          </ol>
          <button class="btn btn--lime" type="button" data-pay-sim>Simular un pago</button>
          <p class="fine">Funciona en comercios con Mastercard sin contacto.</p>
        </div>
        <div class="reveal phone-wrap">
          <div class="phone tilt" data-tilt data-pay-phone>
            <div class="phone__screen">
              <div class="phone__notch"></div>
              <div class="phone__card">
                <img src="/images/TC%20Capta%20Card%20frente.svg" alt="" width="482" height="300" />
              </div>
              <div class="phone__state" data-state>
                <svg class="phone__wave" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 7.5a6 6 0 0 1 0 9" /><path d="M12 5a10 10 0 0 1 0 14" /><path d="M15.5 2.5a14 14 0 0 1 0 19" /></svg>
                <span>Acerca a la terminal</span>
              </div>
              <div class="phone__done"><svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7" /></svg><span>Pago listo</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MASTERCARD -->
    <section id="mastercard" class="sec">
      <div class="prop-wrap split">
        <div class="reveal">
          <span class="eyebrow eyebrow--dark">Respaldo Mastercard</span>
          <h2>Llévala a donde vayas.</h2>
          <p>Tu Capta Card es parte de la red Mastercard: úsala en tiendas físicas y en línea, en México y en el extranjero.</p>
          <div class="pills pills--wrap">
            <span>Súper</span><span>Gasolina</span><span>Restaurantes</span><span>Compras en línea</span><span>Viajes</span><span>Suscripciones</span>
          </div>
        </div>
        <div class="stack">
          {mastercardUses.map((u) => (
            <article class="use reveal">
              <span class="use__icon" aria-hidden="true"><svg viewBox="0 0 24 24">{u.paths.map((d) => <path d={d} />)}</svg></span>
              <div><h3>{u.title}</h3><p>{u.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CÓMO FUNCIONA: 27 DÍAS -->
    <section id="como-funciona" class="sec sec--forest">
      <div class="prop-wrap split">
        <div class="reveal">
          <p class="big-num" aria-hidden="true">27</p>
          <h2>días para pagar después de tu corte.</h2>
          <p>Tu fecha de corte es el día 6 de cada mes y tienes 27 días para pagar. Puedes liquidar el saldo del periodo o realizar el pago mínimo, como mejor te acomode.</p>
        </div>
        <div class="timeline reveal" data-timeline>
          <p class="timeline__label">Ejemplo</p>
          <button class="tl" type="button" aria-pressed="true">
            <span class="tl__dot">1</span><span><strong>18 de diciembre</strong><small>Activas tu tarjeta</small></span>
          </button>
          <button class="tl" type="button" aria-pressed="false">
            <span class="tl__dot">2</span><span><strong>6 de enero</strong><small>Primer corte (al menos 15 días después de activarla)</small></span>
          </button>
          <button class="tl" type="button" aria-pressed="false">
            <span class="tl__dot">3</span><span><strong>1 de febrero</strong><small>Fecha límite de pago</small></span>
          </button>
        </div>
      </div>
    </section>

    <!-- TU TARJETA: APP -->
    <section id="tu-tarjeta" class="sec sec--stone">
      <div class="prop-wrap split">
        <div class="reveal">
          <h2>Tu tarjeta, en tus manos.</h2>
          <p>Consulta tu disponible, revisa tus movimientos y administra tu tarjeta. Si la pierdes o ves un cargo que no reconoces, bloquéala al momento.</p>
        </div>
        <figure class="app-stage reveal">
          <div class="app-phone">
            <div class="app-phone__screen">
              <div class="app-phone__top">
                <img src="/images/logo-capta.png" alt="Capta Card" width="473" height="200" />
                <span class="app-phone__badge">Activa</span>
              </div>
              <img class="app-phone__card" src="/images/TC%20Capta%20Card%20frente.svg" alt="" width="482" height="300" />
              <p class="app-phone__label">Disponible</p>
              <p class="app-phone__amount">$8,450.00</p>
              <div class="app-phone__actions">
                <span><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>Bloquear</span>
                <span><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7" /></svg>Pagar</span>
              </div>
              <p class="app-phone__label">Movimientos</p>
              <ul class="app-phone__moves">
                <li><span class="app-phone__ico"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.5 11h11L21 7H6.5" /><circle cx="9" cy="19" r="1.5" /><circle cx="17" cy="19" r="1.5" /></svg></span><span>Supermercado</span><strong>−$845.00</strong></li>
                <li><span class="app-phone__ico"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg></span><span>Compra en línea</span><strong>−$399.00</strong></li>
                <li><span class="app-phone__ico"><svg viewBox="0 0 24 24"><path d="M4 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16" /><path d="M3 21h12M14 9h2a2 2 0 0 1 2 2v5a1.5 1.5 0 0 0 3 0V8l-3-3" /></svg></span><span>Gasolina</span><strong>−$650.00</strong></li>
              </ul>
            </div>
          </div>
          <figcaption>Imagen ilustrativa de la app Capta Card</figcaption>
        </figure>
      </div>
    </section>

    <!-- DESCARGA: 5 PASOS -->
    <section id="descarga" class="sec">
      <div class="prop-wrap">
        <div class="sec__head reveal">
          <span class="eyebrow eyebrow--dark">Cómo obtenerla</span>
          <h2>De tu invitación a tu primera compra, en 5 pasos.</h2>
        </div>
        <ol class="steps">
          {steps.map((s) => (
            <li class="step reveal">
              <span class="step__n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
        <div class="needs reveal">
          <span>Solo necesitas:</span>
          <span>Celular con internet</span>
          <span>SMS de invitación</span>
          <span>Identificación oficial vigente</span>
        </div>
      </div>
    </section>

    <!-- PAGOS -->
    <section id="pagos" class="sec sec--stone">
      <div class="prop-wrap split">
        <div class="reveal">
          <span class="eyebrow eyebrow--dark">Cómo pagar</span>
          <h2>Paga tu tarjeta desde cualquier banco.</h2>
          <p>Haz una transferencia SPEI a tu CLABE Capta Card desde la app de tu banco. Encuentras tu CLABE en la app de Capta Card.</p>
          <p>Puedes pagar hasta tu saldo total.</p>
        </div>
        <ol class="pay-steps">
          <li class="reveal"><span class="pay-steps__n">Paso 1</span><strong>Copia tu CLABE</strong><small>La encuentras en la app de Capta Card.</small></li>
          <li class="reveal"><span class="pay-steps__n">Paso 2</span><strong>Entra a la app de tu banco</strong><small>Desde cualquier banco en México.</small></li>
          <li class="reveal"><span class="pay-steps__n">Paso 3</span><strong>Transfiere por SPEI</strong><small>Liquida tu saldo o haz tu pago mínimo.</small></li>
        </ol>
      </div>
    </section>

    <!-- SEGURIDAD -->
    <section id="seguridad" class="sec sec--sec">
      <div class="prop-wrap">
        <div class="sec-center reveal">
          <h2>Tu dinero, protegido.</h2>
          <p>Tu Capta Card es segura: tienes el control desde la app y un equipo que te acompaña si algo no se ve bien.</p>
          <a class="btn btn--dark" href="#ayuda">Más información</a>
        </div>
        <div class="sec-cards">
          <article class="sec-card sec-card--green reveal">
            <h3>¿Perdiste tu tarjeta? Bloquéala en segundos desde la app.</h3>
            <div class="sec-card__visual">
              <img src="/images/TC%20Capta%20Card%20frente.svg" alt="" width="482" height="300" />
            </div>
            <div class="sec-card__icons" aria-hidden="true">
              <span><svg viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg></span>
              <span class="is-on"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg></span>
              <span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg></span>
            </div>
          </article>
          <article class="sec-card sec-card--dark reveal">
            <h3>Tu NIP, CVV y códigos son solo tuyos.</h3>
            <div class="sec-card__rows">
              <div><span>NIP</span><span aria-hidden="true">••••</span></div>
              <div><span>CVV</span><span aria-hidden="true">•••</span></div>
            </div>
            <p class="sec-card__note">Capta Card nunca te los pedirá por correo, mensaje ni llamada.</p>
          </article>
          <article class="sec-card sec-card--ink reveal">
            <h3>¿Un cargo que no reconoces? Te damos un folio de seguimiento.</h3>
            <div class="sec-card__claim">
              <div class="sec-card__row"><span>Aclaración</span><span class="sec-card__pill">En revisión</span></div>
              <strong>Folio [NÚMERO]</strong>
              <div class="sec-card__bar" aria-hidden="true"><i></i></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="ayuda" class="sec sec--stone">
      <div class="prop-wrap split">
        <div class="reveal">
          <span class="eyebrow eyebrow--dark">Preguntas frecuentes</span>
          <h2>¿Tienes dudas?</h2>
          <p>Escríbenos a <a href="mailto:soporte@captacard.com">soporte@captacard.com</a> o a nuestro WhatsApp <a href="https://wa.me/525536484526">55 3648 4526</a>, de lunes a viernes de 9:00 a 18:00.</p>
        </div>
        <div class="acc reveal">
          {faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="sec sec--forest">
      <div class="prop-wrap cta reveal">
        <div>
          <h2>¿Ya recibiste tu invitación?</h2>
          <p>Descarga la app, regístrate y empieza a hacer crecer tu futuro.</p>
        </div>
        <a class="btn btn--lime" href="#descarga">Solicitar mi Capta Card</a>
      </div>
    </section>

    <footer class="prop-foot">
      <div class="prop-wrap prop-foot__grid">
        <div>
          <img src="/images/logo-capta.png" alt="Capta Card" width="473" height="200" />
          <p>El crédito que hace crecer tu futuro.</p>
        </div>
        <div>
          <span>Atención</span>
          <a href="tel:5536484526">55 3648 4526</a>
          <a href="mailto:soporte@captacard.com">soporte@captacard.com</a>
          <span>Lunes a viernes, 9:00 a 18:00</span>
        </div>
        <div>
          <span>Ayuda</span>
          <a href="/legal/aclaraciones">Aclaraciones</a>
          <a href="/legal/aclaraciones#robo-o-extravio">Robo o extravío</a>
          <span>PROFECO: 55 5568 8722 · 800 468 8722</span>
        </div>
        <div>
          <span>Transparencia</span>
          <a href="/legal/aviso-de-privacidad">Aviso de privacidad</a>
          <a href="/legal/terminos-y-condiciones">Términos de la app</a>
          <a href="/legal/contrato">Contrato de adhesión</a>
          <a href="/legal/comisiones-y-cat">Comisiones y CAT</a>
        </div>
      </div>
      <div class="prop-wrap prop-foot__legal">
        <p>Tasa de interés fija de 65% anual, sujeta a aprobación. Las condiciones vigentes del producto prevalecen. Crédito otorgado por Capital Productivo del Noroeste, S.A.P.I. de C.V. Tarjeta emitida por Pomelo Tech S.A. de C.V., bajo licencia de Mastercard Internacional.</p>
        <p>© 2026 Capta Card.</p>
      </div>
    </footer>
  </div>

  <script>
    // Reveal al entrar en pantalla (sin animación si el usuario lo pide)
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealEls = document.querySelectorAll<HTMLElement>(".prop .reveal");
    if (reduce || !("IntersectionObserver" in window)) {
      revealEls.forEach((el) => el.classList.add("is-in"));
    } else {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12 },
      );
      revealEls.forEach((el) => io.observe(el));
    }

    // Inclinación 3D siguiendo el cursor (tarjeta y teléfono)
    if (!reduce) {
      document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
        const stage = el.closest<HTMLElement>("[data-tilt-stage], .phone-wrap") ?? el;
        stage.addEventListener("pointermove", (ev) => {
          const r = el.getBoundingClientRect();
          const x = (ev.clientX - r.left) / r.width - 0.5;
          const y = (ev.clientY - r.top) / r.height - 0.5;
          el.style.setProperty("--rx", `${(-y * 16).toFixed(2)}deg`);
          el.style.setProperty("--ry", `${(x * 22).toFixed(2)}deg`);
        });
        stage.addEventListener("pointerleave", () => {
          el.style.setProperty("--rx", "0deg");
          el.style.setProperty("--ry", "0deg");
        });
      });
    }

    // Simulación de pago en el teléfono de Wallet
    const payBtn = document.querySelector<HTMLButtonElement>("[data-pay-sim]");
    const phone = document.querySelector<HTMLElement>("[data-pay-phone]");
    if (payBtn && phone) {
      payBtn.addEventListener("click", () => {
        phone.classList.remove("is-paid");
        phone.classList.add("is-paying");
        window.setTimeout(() => {
          phone.classList.remove("is-paying");
          phone.classList.add("is-paid");
        }, reduce ? 0 : 1600);
        window.setTimeout(() => phone.classList.remove("is-paid"), reduce ? 1200 : 4200);
      });
    }

    // Línea de tiempo de 27 días: elegir un paso lo resalta
    document.querySelectorAll<HTMLButtonElement>(".tl").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLButtonElement>(".tl").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      });
    });
  </script>

