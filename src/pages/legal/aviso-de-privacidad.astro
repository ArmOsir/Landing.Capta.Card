  {
    "id": "datos-personales-que-recabamos",
    "title": "Datos personales que recabamos"
  },
  {
    "id": "finalidades-primarias",
    "title": "Finalidades primarias"
  },
  {
    "id": "finalidades-secundarias",
    "title": "Finalidades secundarias"
  },
  {
    "id": "transferencias",
    "title": "Transferencias"
  },
  {
    "id": "derechos-arco-revocacion-y-limitacion-de-uso",
