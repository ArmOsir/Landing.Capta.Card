---
import LegalLayout from "../../layouts/LegalLayout.astro";
import Pending from "../../components/Pending.astro";
import { condusef, contact, legal } from "../../data/site";

const sections = [
  { id: "une", title: "Unidad Especializada de Atención" },
  { id: "aclaracion", title: "Cómo presentar una aclaración" },
  { id: "plazos", title: "Plazos" },
  { id: "robo", title: "Robo o extravío" },
  { id: "condusef", title: "CONDUSEF" },
];
---

<LegalLayout
  title="UNE y aclaraciones"
  slug="une-y-aclaraciones"
  summary="Si no reconoces un cargo o tienes una queja, aquí te explicamos a quién acudir y qué pasos seguir."
  sections={sections}
>
  <section id="une">
    <h2>Unidad Especializada de Atención (UNE)</h2>
    <p>La UNE atiende tus consultas, reclamaciones y aclaraciones sobre tu tarjeta.</p>
    <div class="legal__table">
      <table>
        <tbody>
          <tr><th scope="row">Titular</th><td><Pending>nombre del titular de la UNE</Pending></td></tr>
          <tr><th scope="row">Domicilio</th><td>{legal.une || <Pending>domicilio</Pending>}</td></tr>
          <tr><th scope="row">Teléfono</th><td>{contact.phone || <Pending>teléfono</Pending>}</td></tr>
          <tr><th scope="row">Correo</th><td><Pending>correo de la UNE</Pending></td></tr>
          <tr><th scope="row">Horario</th><td><Pending>días y horario de atención</Pending></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="aclaracion">
    <h2>Cómo presentar una aclaración</h2>
    <ol class="legal__steps">
      <li>Bloquea tu tarjeta desde la app si crees que alguien la está usando.</li>
      <li>
        Presenta tu aclaración en <Pending>canal: app, correo de la UNE o teléfono</Pending>. Indica la fecha, el monto
        y el comercio del cargo.
      </li>
      <li>Recibirás un número de folio. Guárdalo para dar seguimiento.</li>
      <li>Te daremos una respuesta por escrito con el resultado.</li>
    </ol>
    <p>Mientras se resuelve la aclaración, no tienes que pagar el monto reclamado ni sus intereses.
      <Pending>validar redacción con Cumplimiento</Pending></p>
  </section>

  <section id="plazos">
    <h2>Plazos</h2>
    <div class="legal__table">
      <table>
        <thead>
          <tr><th>Paso</th><th>Plazo</th></tr>
        </thead>
        <tbody>
          <tr><td>Para presentar tu aclaración</td><td><Pending>días desde la fecha de corte</Pending></td></tr>
          <tr><td>Para recibir respuesta</td><td><Pending>días hábiles</Pending></td></tr>
        </tbody>
      </table>
    </div>
    <p><Pending>confirmar plazos con la regulación vigente y el contrato</Pending></p>
  </section>

  <section id="robo">
    <h2>Robo o extravío</h2>
    <p>
      Bloquea tu tarjeta en la app de inmediato y repórtala a <Pending>teléfono 24 horas</Pending>. Después puedes
      pedir una reposición.
    </p>
  </section>

  <section id="condusef">
    <h2>CONDUSEF</h2>
    <p>
      Si no estás conforme con la respuesta, puedes acudir a la Comisión Nacional para la Protección y Defensa de los
      Usuarios de Servicios Financieros.
    </p>
    <ul>
      <li>Sitio: <a href={condusef.url} rel="noopener">{condusef.url.replace("https://", "")}</a></li>
      <li>Teléfono: <Pending>confirmar número vigente de CONDUSEF</Pending></li>
    </ul>
  </section>
</LegalLayout>
