---
import LegalLayout from "../../layouts/LegalLayout.astro";
import Pending from "../../components/Pending.astro";
import { contact, legalHref } from "../../data/site";

const sections = [
  { id: "que-son", title: "Qué son las cookies" },
  { id: "cuales", title: "Cuáles usamos" },
  { id: "eleccion", title: "Tu elección" },
  { id: "navegador", title: "Cómo borrarlas" },
];
---

<LegalLayout
  title="Política de cookies"
  slug="politica-de-cookies"
  summary="Qué guardamos en tu navegador cuando visitas este sitio y cómo puedes controlarlo."
  sections={sections}
>
  <section id="que-son">
    <h2>Qué son las cookies</h2>
    <p>
      Son pequeños archivos que un sitio guarda en tu navegador para recordar información, como tus preferencias. Hay
      tecnologías parecidas, como el almacenamiento local, que funcionan igual para fines de esta política.
    </p>
  </section>

  <section id="cuales">
    <h2>Cuáles usamos</h2>
    <div class="legal__table">
      <table>
        <thead>
          <tr><th>Nombre</th><th>Tipo</th><th>Para qué</th><th>Duración</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>capta-theme</code></td>
            <td>Necesaria</td>
            <td>Recordar si prefieres el modo claro u oscuro.</td>
            <td>Hasta que la borres</td>
          </tr>
          <tr>
            <td><code>capta-cookies</code></td>
            <td>Necesaria</td>
            <td>Recordar tu elección en el aviso de cookies.</td>
            <td>Hasta que la borres</td>
          </tr>
          <tr>
            <td><Pending>herramienta de analítica</Pending></td>
            <td>Analítica</td>
            <td>Saber cuántas personas visitan el sitio y qué secciones leen.</td>
            <td><Pending>duración</Pending></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      Hoy el sitio no usa cookies de analítica ni de publicidad. <Pending>confirmar si se agregará analítica y
      cuál</Pending>
    </p>
  </section>

  <section id="eleccion">
    <h2>Tu elección</h2>
    <p>
      Al entrar al sitio te preguntamos si aceptas todas las cookies o solo las necesarias. Las necesarias siempre están
      activas porque sin ellas el sitio no funciona bien.
    </p>
    <p>
      <button type="button" class="btn btn--ghost" data-cookie-reset>Cambiar mi elección</button>
    </p>
  </section>

  <section id="navegador">
    <h2>Cómo borrarlas</h2>
    <p>
      Puedes borrar las cookies y el almacenamiento del sitio desde la configuración de tu navegador. Más detalles en el
      <a href={legalHref("aviso-de-privacidad")}>Aviso de privacidad</a> o escribiendo a
      <a href={`mailto:${contact.supportEmail}`}>{contact.supportEmail}</a>.
    </p>
  </section>
</LegalLayout>

<script>
  document.querySelector("[data-cookie-reset]")?.addEventListener("click", () => {
    try {
      localStorage.removeItem("capta-cookies");
    } catch {}
    const notice = document.querySelector<HTMLElement>("[data-cookie-notice]");
    if (notice) notice.hidden = false;
  });
</script>
